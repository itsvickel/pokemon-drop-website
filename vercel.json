{
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/check-alerts", "schedule": "0 */6 * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
